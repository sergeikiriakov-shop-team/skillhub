# Copy to .env and fill in values. Never commit the real .env.
#
# NOTE: the service does NOT call an LLM. Evaluation/categorization/synthesis are done by each
# developer's Claude Code, which fetches the shared rubric (GET /api/rubric) and submits results
# back over the API. So there is no ANTHROPIC_API_KEY / model config here.

# --- Embeddings (local, no external key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=skillhub
POSTGRES_DB=skillhub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
# CORS origins for local frontend dev (comma-separated)
SKILLHUB_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Auth: GitHub OAuth (browser login) ---
# Reads are open; humans log in with GitHub, the MCP authorizes via the device flow.
# Register an OAuth App under your GitHub account: Settings → Developer settings → OAuth Apps →
# New OAuth App (no org/consent-screen setup needed). The "Authorization callback URL" must match
# SKILLHUB_PUBLIC_URL + /api/auth/callback exactly (dev: http://localhost:8080/api/auth/callback).
# NEVER commit the real secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public base URL the browser reaches SkillHub at (same origin as the SPA). Docker portal = :8080.
# In production with TLS this is the https URL, e.g. https://<ip>.sslip.io
SKILLHUB_PUBLIC_URL=http://localhost:8080
# Override only if your callback URL differs from SKILLHUB_PUBLIC_URL + /api/auth/callback.
OAUTH_REDIRECT_URI=

# --- TLS (optional; enables the `caddy` service in docker-compose.prod.yml) ---
# Set to a DNS name that resolves to this host to get automatic Let's Encrypt HTTPS. With only an
# IP and no domain, use an sslip.io name, e.g. 166.1.29.218.sslip.io. Leave empty to skip TLS
# (plain http on WEB_PORT). Needs ports 80 + 443 reachable.
SKILLHUB_DOMAIN=

# --- Auth: sessions / roles ---
SKILLHUB_SESSION_TTL=1209600            # session cookie lifetime, seconds (14 days)
SKILLHUB_DEFAULT_ROLE=viewer            # role for a brand-new user (viewer can't write)
SKILLHUB_BOOTSTRAP_ADMINS=              # comma-separated emails promoted to admin on first login
SKILLHUB_COOKIE_SECURE=false            # true in production (HTTPS); MUST be false on http://localhost
# Deprecated break-glass admin token (minted on first boot if the users table is empty).
# Prefer SKILLHUB_BOOTSTRAP_ADMINS. The MCP can also use it as SKILLHUB_TOKEN to skip the device flow.
SKILLHUB_ADMIN_TOKEN=
# Optional explicit bearer token for the MCP (skips the device flow; e.g. CI). Normally leave empty.
SKILLHUB_TOKEN=

# --- Web (build-time; the nginx proxy makes /api relative, usually leave as-is) ---
WEB_PORT=8080

# --- Docker network MTU ---
# Leave at 1500 normally. If you are behind a VPN / restrictive network and large
# downloads (npm tarballs, pip/torch wheels, the embedding model) hang while small
# requests succeed, this is an MTU black hole — set a lower MTU, e.g. 1280.
# NOTE: this only affects the RUNTIME network. To fix it for image BUILDS too, set the
# Docker Desktop daemon MTU as well (see README → Troubleshooting).
DOCKER_MTU=1500
