# Copy to .env and fill in values. Never commit the real .env.

# --- LLM (Claude via Anthropic) ---
# Required for evaluation / categorization / synthesis. Leave empty to run the
# stack without LLM features (import + browse still work).
ANTHROPIC_API_KEY=
# Default model for evaluation and categorization. Latest Claude models:
# claude-opus-4-8, claude-sonnet-5, claude-haiku-4-5-20251001, claude-fable-5
SKILLHUB_LLM_MODEL=claude-sonnet-5
SKILLHUB_LLM_TEMPERATURE=0
SKILLHUB_LLM_MAX_TOKENS=4096

# --- Embeddings (local, no external key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=skillhub
POSTGRES_DB=skillhub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
# CORS origins for local frontend dev (comma-separated)
SKILLHUB_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Web (build-time; the nginx proxy makes /api relative, usually leave as-is) ---
WEB_PORT=8080

# --- Docker network MTU ---
# Leave at 1500 normally. If you are behind a VPN / restrictive network and large
# downloads (npm tarballs, pip/torch wheels, the embedding model) hang while small
# requests succeed, this is an MTU black hole — set a lower MTU, e.g. 1280.
# NOTE: this only affects the RUNTIME network. To fix it for image BUILDS too, set the
# Docker Desktop daemon MTU as well (see README → Troubleshooting).
DOCKER_MTU=1500

# --- Airflow (only used with the `airflow` compose profile) ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_WEB_PORT=8081
